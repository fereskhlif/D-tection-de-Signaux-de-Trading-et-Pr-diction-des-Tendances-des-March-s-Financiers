# ============================================================
# AlphaML Backend — .env.example
# Copy to .env and fill in your values.
# NEVER commit .env to git!
# ============================================================

# --- App ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
APP_VERSION=1.0.0
CACHE_TTL=600

# --- Database ---
DATABASE_URL=sqlite:///./alphaml.db

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Frontend URL (used in reset-password emails) ---
FRONTEND_URL=http://localhost:5173

# --- SMTP (Gmail app password recommended) ---
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AlphaML <your@gmail.com>
